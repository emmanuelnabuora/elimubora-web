# API
PORT=4000
NODE_ENV=development
# App role: RLS enforced. Worker role (cross-tenant policies) is used only by the outbox relay & jobs.
DATABASE_URL=postgres://elimubora_app:app_dev_password@localhost:5432/elimubora
WORKER_DATABASE_URL=postgres://elimubora_worker:worker_dev_password@localhost:5432/elimubora
# Owner/admin connection used ONLY by migrations (tools/migrate.mjs)
MIGRATIONS_DATABASE_URL=postgres://elimubora:elimubora_dev_password@localhost:5432/elimubora
OUTBOX_POLL_MS=1000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (Sprint 2) — generate real values: openssl rand -hex 32
AUTH_JWT_SECRET=dev-only-change-me-9f3b1c7a2e64d8f0a1b2c3d4e5f60718
AUTH_ENC_KEY=6f1d2b3c4a5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
ALLOW_OPEN_REGISTRATION=true
PUBLIC_WEB_URL=http://localhost:3000
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
SYNC_VISIBILITY_DELAY_SECONDS=2
