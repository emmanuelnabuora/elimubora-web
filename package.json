{
  "name": "elimubora",
  "private": true,
  "version": "0.1.0",
  "description": "ElimuBora — Kenya's National Digital Education Platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:migrate": "node tools/migrate.mjs",
    "dev:api": "npm run start:dev --workspace @elimubora/api",
    "dev:web": "npm run dev --workspace @elimubora/web"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.6.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "packageManager": "npm@10.9.7"
}
